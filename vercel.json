{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "public" }
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "crons": [
    {
      "path": "/api/weekly-low-stock.js",
      "schedule": "0 9 * * 1"
    }
  ]
}
